# Copy to .env and fill in: cp .env.example .env

# --- Required ---

DATABASE_URL=postgresql://username:password@localhost:5432/umami

# Signs and encrypts session tokens. Generate with: openssl rand -base64 32
# If unset, the key is derived from DATABASE_URL, which is not safe.
# Changing this after setup invalidates all existing sessions.
APP_SECRET=

# --- Optional ---

# Enables two-factor authentication. Generate with: openssl rand -hex 32
# 2FA cannot be enabled or required until this is set.
# TWO_FACTOR_ENCRYPTION_KEY=

# Direct (unpooled) connection string, used for schema migrations only.
# Set this when DATABASE_URL points at a pooler (PgBouncer, Supabase, Neon).
# DIRECT_DATABASE_URL=

# Enables Redis-backed sessions, which can be revoked server-side.
# REDIS_URL=redis://localhost:6379

# Base URL for internal UI API calls. Relative paths are served under BASE_PATH.
# API_URL=

# Enables the /mcp endpoint. Authenticate with an API key from Settings → API keys.
# MCP_ENABLED=1

# Skip build-time database checks, e.g. in CI against a dummy URL.
# SKIP_DB_CHECK=1
# SKIP_DB_MIGRATION=1
